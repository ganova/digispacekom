# Salin menjadi .env lalu isi. File .env TIDAK boleh di-commit.

# Alamat situs (tanpa garis miring di akhir)
APP_URL=https://digispacekom.net

# Password database: ganti dengan teks acak panjang (lihat panduan instalasi)
DB_PASSWORD=ganti-dengan-password-acak
DB_ROOT_PASSWORD=ganti-dengan-password-acak-lain

# Port Nginx di server. 127.0.0.1 = hanya bisa diakses dari server itu sendiri
# (cocok untuk Cloudflare Tunnel). Isi 0.0.0.0 agar bisa dibuka dari PC lain di jaringan.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Nomor WhatsApp untuk tombol & form booking (format 62..., tanpa +)
SITE_WHATSAPP=6281385028980
SITE_PHONE=0813-8502-8980

# Token Cloudflare Tunnel (dari dashboard Cloudflare Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=
